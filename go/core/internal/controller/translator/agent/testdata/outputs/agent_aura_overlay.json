      "stringData": {
        "config.toml": "# Generated by kagent for the \"aura\" runtime. Do not edit; managed by the Agent CR.\n\n[agent]\nname = \"aura-overlay\"\nsystem_prompt = \"You are an SRE orchestrator.\"\n\n[agent.llm]\nprovider = \"openai\"\napi_key = \"{{ env.OPENAI_API_KEY }}\"\nmodel = \"gpt-4o\"\n\n# --- overlay from spec.declarative.auraConfigFrom ---\n[orchestration]\nenabled = true\nmax_planning_cycles = 3\n"
      }
    },
    {
      "apiVersion": "v1",
      "kind": "ServiceAccount",
