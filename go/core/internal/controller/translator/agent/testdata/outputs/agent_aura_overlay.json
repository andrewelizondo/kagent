    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "labels": {
          "app": "kagent",
          "app.kubernetes.io/managed-by": "kagent",
          "app.kubernetes.io/name": "aura-overlay",
          "app.kubernetes.io/part-of": "kagent",
          "kagent": "aura-overlay"
        },
        "name": "aura-overlay",
        "namespace": "test",
